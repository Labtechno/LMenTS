<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>LMenTS @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <os-version min="11.0"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="Plugin VST3 (pour Reason)"
            description="LMenTS.vst3, dans /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.labtechno.lments.vst3"/>
    </choice>
    <choice id="app" title="Application LMenTS"
            description="LMenTS sans Reason, dans le dossier Applications.">
        <pkg-ref id="com.labtechno.lments.app"/>
    </choice>
    <pkg-ref id="com.labtechno.lments.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
    <pkg-ref id="com.labtechno.lments.app" version="@VERSION@">app.pkg</pkg-ref>
</installer-gui-script>
